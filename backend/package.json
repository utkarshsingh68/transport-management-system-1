{
  "name": "tms-backend",
  "version": "1.0.0",
  "description": "Backend API for Transport Management System",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "init-db": "node scripts/initDatabase.js",
    "migrate-trip-money": "node scripts/migrateTripMoneyFields.js",
    "migrate-trip-spend-expenses": "node scripts/migrateTripSpendExpenses.js",
    "migrate-documents": "node scripts/migrateDocuments.js",
    "migrate-driver-assignment": "node scripts/migrateDriverAssignment.js",
    "migrate-payment-system": "node scripts/migratePaymentSystem.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "groq-sdk": "^0.37.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.14.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
